export function pageBackgroundMotifs(setId: string): PageBackgroundMotif[] {
  return PAGE_BACKGROUND_MOTIFS.filter((motif: PageBackgroundMotif): boolean => motif.setId === setId);
}

export function validPageMotif(id: string): boolean {
  return PAGE_BACKGROUND_MOTIFS.some((motif: PageBackgroundMotif): boolean => motif.id === id);
}
