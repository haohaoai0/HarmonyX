export function accountManagementSection(id: string): AccountManagementSection {
  for (let i: number = 0; i < ACCOUNT_MANAGEMENT_SECTIONS.length; i++) {
    if (ACCOUNT_MANAGEMENT_SECTIONS[i].id === id) { return ACCOUNT_MANAGEMENT_SECTIONS[i]; }
  }
  return ACCOUNT_MANAGEMENT_SECTIONS[0];
}
