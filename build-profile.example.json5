// Safe public template for DevEco signing configuration.
// Copy this file to build-profile.json5 and replace every placeholder locally.
// Never commit build-profile.json5 or any certificate / keystore material.
{
  "app": {
    "signingConfigs": [
      {
        "name": "default",
        "type": "HarmonyOS",
        "material": {
          "storeFile": "C:\\path\\to\\your-signing-key.p12",
          "storePassword": "REPLACE_WITH_KEYSTORE_PASSWORD",
          "keyAlias": "REPLACE_WITH_KEY_ALIAS",
          "keyPassword": "REPLACE_WITH_KEY_PASSWORD",
          "signAlg": "SHA256withECDSA",
          "profile": "C:\\path\\to\\your-profile.p7b",
          "certpath": "C:\\path\\to\\your-certificate.cer"
        }
      }
    ],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "compatibleSdkVersion": "6.1.0(23)",
        "runtimeOS": "HarmonyOS",
        "targetSdkVersion": "26.0.0"
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
