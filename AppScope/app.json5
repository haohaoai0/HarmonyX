{
  "app": {
    "bundleName": "com.haohaoai0.CroakX",
    "vendor": "haohaoai0",
    "versionCode": 22,
    "versionName": "3.0.0",
    "icon": "$media:app_layered_image",
    // 备用图标在应用包内声明，7.0（API 26）起可由应用自己切换，
    // 不再依赖 AppGallery Connect 的动态图标服务与审核。
    "alternateIcons": [
      {
        // The pre-Croak X default icon remains selectable as "Classic".
        "name": "classic",
        "icon": "$media:alt_icon_classic"
      },
      {
        "name": "spectrum",
        "icon": "$media:alt_icon_spectrum"
      },
      {
        "name": "outline",
        "icon": "$media:alt_icon_outline"
      },
      {
        "name": "brush",
        "icon": "$media:alt_icon_brush"
      },
      {
        "name": "blossom",
        "icon": "$media:alt_icon_blossom"
      },
      {
        "name": "blue_bird",
        "icon": "$media:alt_icon_blue_bird"
      },
      {
        "name": "twitter_blue",
        "icon": "$media:alt_icon_twitter_blue"
      },
      {
        "name": "twitter_white",
        "icon": "$media:alt_icon_twitter_white"
      },
      {
        "name": "x_black",
        "icon": "$media:alt_icon_x_black"
      },
      {
        "name": "x_white",
        "icon": "$media:alt_icon_x_white"
      },
      {
        "name": "frog_white",
        "icon": "$media:alt_icon_frog_white"
      },
      {
        "name": "frog_black",
        "icon": "$media:alt_icon_frog_black"
      },
      {
        "name": "milk_frog_white",
        "icon": "$media:alt_icon_milk_frog_white"
      },
      {
        "name": "milk_frog_black",
        "icon": "$media:alt_icon_milk_frog_black"
      },
      {
        // 中秋限时图标，9 月 25 日至 9 月 28 日在设置里可选，
        // 过期后由设置页自动换回默认图标。
        "name": "mid_autumn",
        "icon": "$media:alt_icon_mid_autumn"
      }
    ],
    "label": "$string:app_name",
    "configuration": "$profile:configuration"
  }
}
