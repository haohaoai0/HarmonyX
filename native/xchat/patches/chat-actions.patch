+    /// Sign the conversation deletion event used by the private XChat API.
+    pub fn prepare_conversation_delete(
+        &self, conversation_id: &str,
+    ) -> Result<crate::signatures::ActionSignature, SdkError> {
+        if conversation_id.is_empty() { return Err(SdkError::Parse("missing conversation id".into())); }
+        let sender_id = self.resolve_sender_id(None)?;
+        let key_version = self.resolve_signing_key_version(None)?;
+        let conversation_id = crate::pipeline::canonical_conversation_id(conversation_id, &sender_id);
+        let message_id = Self::generate_message_id();
+        let detail = crate::thrift::event::MessageEventDetail::ConversationDeleteEvent(
+            crate::thrift::event::ConversationDeleteEvent::new(
+                Some(conversation_id.to_string()), None::<crate::thrift::event::ClearConversationOptions>));
+        let payload = build_component_payload("ConversationDeleteEvent", &message_id,
+            &sender_id, Some(&conversation_id), &[])
+            .ok_or_else(|| SdkError::Parse("invalid action identity".into()))?;
+        let signature = self.sign(&payload)?;
+        Ok(crate::signatures::ActionSignature {
+            message_id, encoded_message_event_detail: base64_encode(&crate::pipeline::serialize_thrift(&detail)?),
+            signature: base64_encode(&signature), signature_version: crate::signatures::SIGNATURE_VERSION.into(),
+            public_key_version: key_version, signature_payload: String::new(),
+        })
+    }
+
+    /// Encrypt a read receipt using the private client's message-content type.
+    pub fn prepare_plain_read_receipt(&self, conversation_id: &str, seen_until: &str) -> Result<(String, String), SdkError> {
+        if conversation_id.is_empty() || seen_until.is_empty() {
+            return Err(SdkError::Parse("missing read target".into()));
+        }
+        let sender = self.resolve_sender_id(None)?;
+        let version = self.resolve_signing_key_version(None)?;
+        let conversation = crate::pipeline::canonical_conversation_id(conversation_id, &sender);
+        let id = Self::generate_message_id();
+        let detail = MessageEventDetail::MarkConversationReadEvent(
+            crate::thrift::event::MarkConversationReadEvent::new(Some(seen_until.to_string()), None::<i64>));
+        let payload = build_component_payload("MarkConversationReadEvent", &id, &sender,
+            Some(&conversation), &[seen_until]).ok_or_else(|| SdkError::Parse("invalid read identity".into()))?;
+        let signature = crate::thrift::event::MessageEventSignature::new(
+            Some(base64_encode(&self.sign(&payload)?)), Some(version),
+            Some(crate::signatures::SIGNATURE_VERSION.to_string()), None, None);
+        let event = MessageEvent::new(None::<String>, Some(id.clone()), Some(sender), Some(conversation.into_owned()),
+            None::<String>, None::<String>, Some(detail), None::<crate::thrift::event::MessageEventRelaySource>,
+            Some(signature), None::<String>, None::<bool>);
+        Ok((id, base64_encode(&crate::pipeline::serialize_thrift(&event)?)))
+    }
+
+    /// Encrypt a read receipt using the private client's message-content type.
+    pub fn encrypt_read_receipt(
+        &self, conversation_id: &str, seen_until: &str,
+    ) -> Result<SendPayload, SdkError> {
+        if conversation_id.is_empty() || seen_until.is_empty() {
+            return Err(SdkError::Parse("missing read target".into()));
+        }
+        let sender_id = self.resolve_sender_id(None)?;
+        let signing_key_version = self.resolve_signing_key_version(None)?;
+        let (ckey, key_version) = self.resolve_conversation_key(None, None, conversation_id, &sender_id)?;
+        let signing = self.get_signing_keypair_arc()?;
+        let holder = crate::thrift::product::MessageEntryHolder::new(Some(Box::new(
+            crate::thrift::product::MessageEntryContents::MarkConversationRead(
+                Box::new(crate::thrift::product::MarkConversationRead::new(Some(seen_until.to_string()), None::<i64>))))));
+        let content = crate::pipeline::serialize_thrift(&holder)?;
+        let message_id = Self::generate_message_id();
+        crate::pipeline::encrypt_and_sign(crate::pipeline::EncryptAndSignParams::new(
+            &ckey, &signing.private, &message_id, &sender_id, conversation_id, &content,
+            &key_version, &signing_key_version).should_notify(false))
     }
 
